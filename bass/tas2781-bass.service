[Unit]
Description=Enable the TAS2781 bass speakers (Speaker Force Firmware Load)

[Service]
Type=oneshot
ExecStart=/bin/sh -c 'for i in $(seq 30); do /usr/bin/amixer -q -c sofhdadsp cset "iface=CARD,name=Speaker Force Firmware Load" on && exit 0; sleep 1; done; exit 1'

[Install]
WantedBy=default.target
